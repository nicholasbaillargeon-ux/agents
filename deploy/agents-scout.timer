[Unit]
Description=Sweep the job boards nightly and diff against what was already seen

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
# Twenty public job boards get hit in sequence; a jittered start keeps this from
# looking like a scripted sweep arriving on the same second every night.
RandomizedDelaySec=900
AccuracySec=1min

[Install]
WantedBy=timers.target
