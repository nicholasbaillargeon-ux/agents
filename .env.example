# --- LLM (Anthropic Messages API; a LiteLLM gateway speaking it works too) ---
AGENTS_LLM_BASE_URL=https://litellm.baillargeon.casa
AGENTS_LLM_API_KEY=
AGENTS_WRITE_MODEL=claude-sonnet-5
AGENTS_FAST_MODEL=claude-haiku-4-5

# --- Storage ---
AGENTS_DATA_DIR=/home/nbaillar/agents_work/data
# Research notes are committed to this git repo. Set AGENTS_GIT_REMOTE to also push.
AGENTS_GIT_REMOTE=

# --- Sources ---
SEC_USER_AGENT=agents_work/0.1 (nicholas.baillargeon@gmail.com)
AGENTS_LAKE_DIR=/home/nbaillar/market-lab/data/lake
AGENTS_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,TLT,GLD

# --- RAG analyst roots (colon-separated; missing roots are skipped) ---
AGENTS_VAULT_ROOTS=/home/nbaillar/Brain:/home/nbaillar/agents_work/data/research-notes

# --- Web ---
AGENTS_PORT=8110

# --- Morning tape push (ntfy) ---
# The topic name is the *only* credential ntfy has: anyone who knows it can
# read the brief and post to it. Generate a random one and keep it out of git.
#   head -c 9 /dev/urandom | base32 | tr '[:upper:]' '[:lower:]' | tr -d '='
# Then subscribe to it in the ntfy app. Leave blank to write the brief without
# pushing it — an unconfigured push is a reported degradation, not an error.
AGENTS_NTFY_TOPIC=
AGENTS_NTFY_SERVER=https://ntfy.sh

# --- Deal book (Postgres) ---
# The one store here that is not SQLite. Bring it up with:
#   docker run -d --name dealbook-db --restart unless-stopped \
#     -e POSTGRES_PASSWORD=... -e POSTGRES_USER=dealbook -e POSTGRES_DB=dealbook \
#     -v dealbook-pgdata:/var/lib/postgresql/data \
#     -p 127.0.0.1:55432:5432 postgres:16-alpine
# Bound to localhost on purpose: the dashboard is unauthenticated on the LAN,
# so the database behind it must not be. Blank means deals are drafted and
# shown but not persisted.
AGENTS_DEALBOOK_DSN=

# Advisors worth a flag, and the size floor a deal must clear without one.
# An advisor or sector match overrides the floor.
AGENTS_DEAL_ADVISORS=Cantor Fitzgerald,Cantor,BGC Partners
AGENTS_DEAL_MIN_USD=250000000
AGENTS_DEAL_SECTORS=asset manage,wealth manage,investment bank,broker-dealer,exchange,fintech,payments,semiconductor,data center,artificial intelligence,private credit,insurance broker
